+});
+
+// ===========================================================================
+// ƯU ĐÃI — chỉ 2 khoản đã duyệt
+// ===========================================================================
+test('ƯU ĐÃI BỊA — chặn mọi khoản ngoài 2 khoản đã duyệt', () => {
+  const ca = [
+    'Bên em tặng thêm gói chụp X-quang miễn phí ạ.',
+    'Đi 2 người thì được giảm thêm 10% ạ.',
