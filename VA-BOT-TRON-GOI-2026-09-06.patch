+  "name": null,
+  "phone": null,
+  "phone_captured": false,
+  "condition": "goi | vai | gut | lung | tvdd | covaigay | chopxoay | csc | ngontay | cochan | hang | chomdui | loangxuong | dequervain | ongcotay | tenniselbow | gangotchan | khac | unknown",
