+      // Dò lại trên chính chuỗi `o` (boHtml chỉ dùng để đọc số; ô thật hiếm khi có HTML).
+      const idx = o.indexOf(t.raw, Math.max(0, t.dau - 10));
+      if (idx < 0) continue;
