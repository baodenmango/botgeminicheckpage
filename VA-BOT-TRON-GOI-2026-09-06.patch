+    than = `✅ <b>MÁY CANH BOT</b> — ${gio(new Date())}\nĐã lành: ${daLanh.join(', ')}. Bot hoạt động bình thường trở lại.`;
+  }
+
+  // In ra màn hình LUÔN LUÔN (để chạy tay / đọc log cron).
