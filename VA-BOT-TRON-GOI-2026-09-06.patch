+
+// ===========================================================================
+// KHAN HIẾM / HẠN CHÓT BỊA — 2 ưu đãi này KHÔNG có hạn thời gian
+// ===========================================================================
+test('KHAN HIẾM BỊA — bị gỡ khỏi câu', () => {
+  const ca = [
+    'Ưu đãi này chỉ còn 2 suất thôi mình ơi, mình đăng ký sớm nha ạ.',
