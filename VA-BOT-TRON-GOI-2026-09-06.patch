+      }
+    }
+  }
+
+  // ── GỘP + KHOẢNG LẶNG + BẮN ─────────────────────────────────────
+  const nay = Date.now();
+  const cd = tt.coolDown || {};
+  bay.coolDown = { ...cd };
+  const banDi = [];
+  for (const c of canhBao) {
+    const truoc = cd[c.khoa] || 0;
+    if (nay - truoc < COOLDOWN_PHUT * 60000) {
+      binhThuong.push(`🔇 (đang trong khoảng lặng ${COOLDOWN_PHUT}' — không kêu lại: ${c.khoa})`);
