+// ---------------------------------------------------------------------------
+// 1. SOÁT HỒ SƠ — HÀM THUẦN (không I/O, test thẳng)
+// ---------------------------------------------------------------------------
+export const TRUONG_BAT_BUOC = ['benh', 'dichVu', 'ngayLam'];
+export const TEN_TRUONG_VI = {
+  benh: 'bệnh/chẩn đoán',
+  dichVu: 'dịch vụ đã làm',
+  ngayLam: 'ngày làm',
